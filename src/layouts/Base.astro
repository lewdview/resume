---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme?: 'paper' | '365';
  noindex?: boolean;
}
const { title, description, theme = 'paper', noindex = false } = Astro.props;
const PAPER = '#f2efe6';
---
<!doctype html>
<html lang="en" data-skin={theme} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={theme === 'paper' ? PAPER : '#1a1c2e'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <div class="gridlines" aria-hidden="true"></div>

    <header class="nav" transition:persist="nav">
      <a href="/" data-flood={PAPER} data-magnet>Bryan Meason</a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/#work" data-flood={PAPER}><span data-tx="W0RK">Work</span></a>
        <span class="hide-s" aria-disabled="true" title="Coming in the full build">Sound</span>
        <span class="hide-s" aria-disabled="true" title="Coming in the full build">Resume</span>
        <span class="hide-s" aria-disabled="true" title="Coming in the full build">Contact</span>
      </nav>
      <div class="nav-right">
        <span class="bpm" title="The site's tempo. Every animation runs on this clock.">
          <i class="bpm-dot" aria-hidden="true"></i><span class="bpm-text" data-bpm>90 BPM</span>
        </span>
        <button id="sound" class="sound-btn" aria-pressed="false" data-magnet>
          <span data-sound-label>Sound off</span>
        </button>
      </div>
    </header>

    {Astro.slots.has('views') ? <slot name="views" /> : (
      <main data-skin={theme}>
        <slot />
      </main>
    )}

    <footer class="site-foot">
      <div>
        <p class="label">Credits</p>
        <p class="big">Written, designed, built and produced by Bryan Meason.</p>
      </div>
      <div>
        <p class="label">Contact</p>
        <p><a href="mailto:work@th3scr1b3.art">work@th3scr1b3.art</a></p>
        <p>Tucson, Arizona</p>
      </div>
      <div>
        <p class="label">Pressing</p>
        <p>Prototype 0.1. Home and one case study.</p>
        <p data-now="Sound is off. Nothing plays without a click.">Sound is off. Nothing plays without a click.</p>
      </div>
    </footer>

    <audio id="track" transition:persist="track" preload="none" loop
      data-src="/media/poetry.mp3" data-bpm="91" data-title="Poetry, day 008 of 365"></audio>
    <div id="flood" transition:persist="flood" aria-hidden="true"></div>
    <div id="needle" transition:persist="needle" aria-hidden="true"><b></b><i></i></div>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
