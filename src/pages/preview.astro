---
// Single-document build of the prototype: both views in one page, switched in place.
// Used for the shareable preview, where multi-page navigation is not available.
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import Case365 from '../components/Case365.astro';
---
<Base noindex title="Bryan Meason Portfolio" description="Prototype of the Liner Notes portfolio: home page and the 365 Days of Light and Dark case study.">
  <Fragment slot="views">
    <main data-view="home" data-skin="paper"><Home /></main>
    <main data-view="case-365" data-skin="365" hidden><Case365 /></main>
  </Fragment>
</Base>
